# Copy to .env.local (for npm run dev) and add the same two values in Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API (Data API): Project URL and the publishable / anon key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
